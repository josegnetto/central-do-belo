# Copie este arquivo para ".dev.vars" (não commitado) para rodar
# `npm run preview` (wrangler) localmente com as mesmas variáveis do `.env.local`.
#
# Isso é só para testar o build do Cloudflare Worker localmente antes do deploy.
# Pro dia a dia com `npm run dev`, continue usando o `.env.local` normal.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
